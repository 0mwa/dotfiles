{
    "layer": "top",
    "position": "top",
    "mod": "dock",

    "exclusive": true,
    "passtrough": true,
    "gtk-layer-shell": true,
    "fixed-center": true,
    
    "height": 0,
    "name": "omnibar",

    "margin-left": 5,
    "margin-right": 5,
    "margin-top": 5,
    "spacing": 1,  
    "reload_style_on_change": true,

    "modules-left": ["backlight", "clock", "hyprland/language", "hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["cpu", "memory", "pulseaudio", "custom/updates", "battery", "network" ],

    "idle_inhibitor": {
    	"format": "[ {icon} ]",
	"tooltip-format-activated": "IDLE_STATUS: [ ACTIVE ]",
	"tooltip-format-deactivated": "IDLE_STATUS: [ <span color='#B7416E'>NON_ACTIVE</span> ]",
	"format-icons": {
		"activated": "ACT",
		"deactivated": "<span color='#B7416E'>XXX</span>"
	}
    },
    
    "tray": {
        "icon-size": 14,
	    "show-passive-items": true,
        "spacing": 10,
	    "reverse-direction": true
    },

    "memory": {
    	"interval": 20,
	"format": "MEM [ {icon} ] <span size='8pt'>{percentage}%</span>",
	"tooltip-format": "MEM_TOT\t: {total}GiB\nSWP_TOT\t: {swapTotal}GiB\n\nMEM_USD\t: {used:0.1f}GiB\nSWP_USD\t: {swapUsed:0.1f}GiB",
	"format-icons": ["░░░░░░░░", "█░░░░░░░", "██░░░░░░", "███░░░░░", "████░░░░", "█████░░░", "██████░░", "<span color='#B7416E'>!!!!!!!!</span>", "<span color='#B7416E'>CRITICAL</span>"]
    },

    "hyprland/workspaces": {
    	"active-only": false,
	"format": "{icon}",
	"format-icons": {
		"1": "I",
		"2": "II",
		"3": "III",
		"4": "IV",
		"5": "V",
		"6": "VI",
		"7": "VII",
		"8": "VIII",
		"9": "IX",
		"10": "X",
		"11": "XI",
		"12": "XII",
		"13": "XIII",
		"14": "XIV",
		"15": "XV",
		"16": "XVI",
		"17": "XVII",
		"18": "XVIII",
		"19": "XIX",
		"20": "XX"
	}
    },

    "cpu": {
    	"interval": 1,
	"format": "CPU [ {icon} ] <span size='8pt'>{usage}%</span>",
	"tooltip": true,
	"format-icons": ["░░░░░░░░", "█░░░░░░░", "██░░░░░░", "███░░░░░", "████░░░░", "█████░░░", "██████░░", "<span color='#a55377'>!!!!!!!!</span>", "<span color='#a55377'>CRITICAL</span>"]
    },

    "clock": {
        "format": "[ <span color='#2f88ff'>{:%I:%M %p</span> <span size='8pt'> %a %b %d</span>} ]",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode":                       "month",
                "mode-mon-col":           3,
                "weeks-pos":              "right",
                "on-scroll":              1,
                "format": {
				            "months":     "<span size='10pt'><b>{}</b></span>", 
				            "days":       "<span size='10pt'><b>{}</b></span>", 
				            "weeks":      "<span size='10pt'><b>W{}</b></span>", 
				            "weekdays":   "<span size='10pt'><b>{}</b></span>", 
				            "today":      "<span color='#2f88ff'><b><u>{}</u></b></span>"
		                    }
                    },
        "actions":  {
            "on-click-right":             "mode",
            "on-scroll-up":               "shift_up",
            "on-scroll-down":             "shift_down"
            }
    },

    "hyprland/language": {
        "format":           "{}",
        "format-en":        "[ EN ]",
        "format-ru":        "[ RU ]",
        "keyboard-name":    "at-translated-set-2-keyboard"
    },
    
    "pulseaudio": {
        "format": "VOL [ {icon} ] <span size='8pt'>{volume}%</span>",
        "tooltip": true,
	"tooltip-format": "DEVICE: {desc}",
        "format-muted": "VOL <span color='#B7416E'>[ XXXXXXXX ] <span size='8pt'>{volume}%</span></span>",
        "on-click": "pavucontrol",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2",
        "scroll-step": 2,
	"reverse-scrolling": false,
	"format-icons": ["░░░░░░░░", "█░░░░░░░", "██░░░░░░", "███░░░░░", "████░░░░", "█████░░░", "██████░░", "███████░", "████████"]
    },

    "network": {
	"format-wifi": "[ <span color='#798347'>ONLINE</span> ]",
	"format-ethernet": "[ <span> color='#798347'ONLINE</span> ]",
	"tooltip-format-wifi": "ESSID\t: {essid}\nSTRNGTH\t: {signaldBm}\n\nADDRESS\t: {ipaddr}\nGATE\t: {gwaddr}\nMASK\t: {netmask} | {cidr}",
	"tooltip-format-ethernet": "IFNAME: {ifname}\nADDRESS: {ipaddr}",
	"format-disconnected": "[ <span color='#B7416E'>XXXXXX</span> ]",
	"on-click": "nm-connection-editor"
    },

    "battery": {
    	"states": {
		"warning": 20,
		"critical": 15
	},
	"format": "BAT [ {icon} ] <span size='8pt'>{capacity}%</span>",
	"interval": 5,
	"format-charging": "BAT [ {icon} ] <span size='8pt'>CHRG</span>",
	"format-plugged": "BAT [ {icon} ] <span size='8pt'>PLUG</span>",
	"tooltip-format": "BATTERY {power}W\nSTATUS: {timeTo}\nCYCLES: {cycles}\nHEALTH: {health}",
	"format-icons": ["<span color='#a55377'>CRITICAL", "<span color='#a55377'>!!!!!!!!</span>", "██░░░░░░", "███░░░░░", "████░░░░", "█████░░░", "██████░░", "███████░", "████████"]
    },
    
    "backlight": {
        "format":           "[ {icon} ]",
        "format-icons":     ["", "", "", "", "", "", "", "", ""],
        "tooltip-format":   "Left click to save brightness.",
	    "on-click":         "~/.config/waybar/scripts/save_brightness.sh",
	    "on-click-right":   "~/.config/waybar/scripts/load_brightness.sh"
    }    
    
}




